{
  "info": {
    "name": "POS - Sale Module",
    "_postman_id": "b8a1c3e2-5e9c-4a3d-9f0a-1a2b3c4d5e6f",
    "description": "Endpoints used by the Sell Module (sale.html). Set the `baseUrl` variable to your server, default http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Health - GET /api",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api", "host": ["{{baseUrl}}"], "path": ["api"] }
      }
    },
    {
      "name": "Search products - GET /api/sales/search",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/sales/search?q=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sales", "search"],
          "query": [{ "key": "q", "value": "" }]
        }
      }
    },
    {
      "name": "Search products (filter) - GET /api/sales/search?q=skin",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/sales/search?q=skin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sales", "search"],
          "query": [{ "key": "q", "value": "skin" }]
        }
      }
    },
    {
      "name": "Checkout - POST /api/sales/checkout (happy path)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"id\": 4, \"quantity\": 2 }\n  ],\n  \"paymentAmount\": 25\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/sales/checkout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sales", "checkout"]
        }
      }
    },
    {
      "name": "Checkout - empty cart (expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [],\n  \"paymentAmount\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/sales/checkout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sales", "checkout"]
        }
      }
    },
    {
      "name": "Checkout - payment too low (expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [ { \"id\": 4, \"quantity\": 1 } ],\n  \"paymentAmount\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/sales/checkout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sales", "checkout"]
        }
      }
    },
    {
      "name": "Products - GET /api/products",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
      }
    }
  ]
}
